{
  "name": "gac-technique",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others-on-fail \"vite --host 0.0.0.0 --port 44100\" \"npm:dev:api\"",
    "dev:api": "tsx watch server/index.ts",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 44100",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test server/dsn/*.test.ts server/questions/*.test.ts server/answer/*.test.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "csv-parse": "^7.0.2",
    "docx": "^9.7.2",
    "express": "^5.2.1",
    "multer": "^2.4.0",
    "react": "latest",
    "react-dom": "latest",
    "typescript": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "concurrently": "^10.0.5",
    "tsx": "^4.23.15"
  }
}
